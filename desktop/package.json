{
  "name": "miplay-multiroom-desktop",
  "version": "0.2.0",
  "description": "Cross-platform Xiaomi MiPlay Multi-Room Audio Sender (Electron + C++20 Core)",
  "homepage": "https://github.com/Paramecium-max/sound-share",
  "author": "Paramecium-max <sound-share@local>",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "tsc --noEmit && vite build",
    "start": "npm run build:renderer && electron .",
    "dist:linux": "npm run build:renderer && npx --yes electron-builder --linux",
    "dist:win": "python package_windows.py",
    "dist:win:zip": "python package_windows.py --zip-only",
    "dist:mac": "npm run build:renderer && npx --yes electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.5.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.mishare.miplay.sender",
    "productName": "MiPlay MultiRoom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "../core/build/miplay_core_sidecar",
          "to": "bin/miplay_core_sidecar"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../core/build/Release/miplay_core_sidecar.exe",
          "to": "bin/miplay_core_sidecar.exe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "../core/build/miplay_core_sidecar",
          "to": "bin/miplay_core_sidecar"
        }
      ]
    }
  }
}
